# AETHER-GRID edge node agent — local development configuration example.
# Copy to .env (gitignored) and adjust. NEVER commit real credentials.

# --- Control plane ---
# Production deployments MUST use HTTPS.
CONTROL_PLANE_URL=http://localhost:8080

# --- Identity (Phase 10) ---
# Preferred: the operator provisions the node record and hands you a
# single-use bootstrap token together with the node id. The agent exchanges
# it for its long-lived credential on first start.
NODE_ID=
AETHER_BOOTSTRAP_TOKEN=

# Development only: allow anonymous self-registration against a control
# plane started with AUTH_OPEN_REGISTRATION=true.
AUTH_ALLOW_SELF_REGISTRATION=false
# Development only: permit plaintext HTTP to non-loopback addresses.
AGENT_ALLOW_INSECURE_TRANSPORT=false

# --- Node attributes ---
NODE_NAME=edge-01
NODE_LOCATION=local
AGENT_DATA_DIR=./data
AGENT_LISTEN_ADDR=127.0.0.1:9090
AGENT_VERSION=dev

# --- Loops ---
HEARTBEAT_INTERVAL=10s
STATE_REPORT_INTERVAL=30s
COMMAND_POLL_INTERVAL=5s
COMMAND_TIMEOUT=30s
RETRY_INITIAL_BACKOFF=1s
RETRY_MAX_BACKOFF=30s

# --- Kubernetes integration ---
KUBERNETES_ENABLED=false
KUBECONFIG=
KUBERNETES_REQUEST_TIMEOUT=10s
