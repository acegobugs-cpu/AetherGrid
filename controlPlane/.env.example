# AETHER-GRID control plane — local development configuration example.
# Copy to .env (gitignored) and adjust. NEVER commit real credentials.

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATABASE_PATH=./data/aether-grid.db

# --- Environment ---
# development | production. Production refuses to start without TLS and
# human API keys, and never permits anonymous registration.
AETHERGRID_ENV=development

# --- TLS (required in production) ---
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- Authentication ---
# Human API keys as token:role pairs, comma separated.
# Roles: admin, operator, viewer. Generate with e.g.:
#   openssl rand -base64 32
AUTH_STATIC_KEYS=change-me-to-a-long-random-value:admin
# Development-only anonymous self-registration for agents. Refused in
# production.
AUTH_OPEN_REGISTRATION=false

# --- Credential lifecycle ---
BOOTSTRAP_TOKEN_TTL=15m
AGENT_CREDENTIAL_TTL=2160h
MAX_BODY_BYTES=1048576
REGISTER_RATE_PER_MINUTE=30
MUTATION_RATE_PER_MINUTE=120

# --- Reconciliation engine ---
RECONCILIATION_INTERVAL=10s
RECONCILIATION_WORKERS=4
NODE_HEARTBEAT_TIMEOUT=30s

# --- Infrastructure provisioning ---
TERRAFORM_BIN=terraform
TERRAFORM_WORK_DIR=./data/terraform
TERRAFORM_MODULE_DIR=./terraform/modules/edge-node
TERRAFORM_TIMEOUT=5m
